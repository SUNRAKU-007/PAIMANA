# PAIMANA Frontend Environment Variables (Vite)
# Copy this file to .env for local overrides, or configure in Vercel / Netlify / Render dashboard.

# Backend API Base URL (without trailing slash)
# Local development default: http://localhost:8000
# Production example: https://paimana-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000
