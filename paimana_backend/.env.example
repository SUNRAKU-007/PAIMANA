# PAIMANA Backend Environment Variables (FastAPI)
# Copy this file to .env for local overrides, or configure in Render / Railway / Fly.io dashboard.

# Google Gemini API Key (for Project Intelligence Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key for token encoding (generate random 32-byte hex string)
JWT_SECRET=your_jwt_secret_hex_key_here

# Allowed CORS Origins (comma-separated list of origins)
# Local development default: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Production example: https://paimana-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
